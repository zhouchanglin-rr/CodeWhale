# Point the production build at a runtime API origin (must be allowed via the
# runtime's --cors-origin). Leave unset in dev to use the Vite proxy.
# VITE_RUNTIME_BASE=https://your-runtime-host:7878

# Dev-only: where `npm run dev` proxies /v1 and /health.
# VITE_RUNTIME_TARGET=http://127.0.0.1:7878
